{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "preset": "conventionalcommits",
  "presetConfig": {
    "types": [
      { "type": "feat", "section": "Features" },
      { "type": "fix", "section": "Bug Fixes" },
      { "type": "docs", "section": "Documentation" },
      { "type": "refactor", "section": "Refactoring" },
      { "type": "perf", "section": "Performance" },
      { "type": "chore", "section": "Maintenance" },
      { "type": "test", "section": "Tests" },
      { "type": "ci", "section": "CI" },
      { "type": "build", "section": "Build" }
    ]
  },
  "releaseRules": [
    { "type": "feat", "release": "minor" },
    { "type": "fix", "release": "patch" },
    { "type": "perf", "release": "patch" },
    { "type": "refactor", "release": "patch" },
    { "type": "docs", "release": false },
    { "type": "chore", "release": false },
    { "type": "test", "release": false },
    { "type": "ci", "release": false },
    { "type": "build", "release": false }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python - <<'PY'\nfrom pathlib import Path\nimport re\ntext = Path('pyproject.toml').read_text(encoding='utf-8')\nversion = '${nextRelease.version}'\nupdated, count = re.subn(r'(?m)^version = \".*?\"', f'version = \"{version}\"', text, count=1)\nif count != 1:\n    raise SystemExit('Failed to update pyproject.toml version')\nPath('pyproject.toml').write_text(updated, encoding='utf-8')\nPY"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "pyproject.toml"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": ["released"],
        "successComment": ":tada: This release has been published successfully."
      }
    ]
  ]
}
